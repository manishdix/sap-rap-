projection;
strict ( 2 );

define behavior for ZC_ZTRAVEL_MANAGED_D //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use association _booking { create; }
}

define behavior for ZC_ZBOOKING_MANAGED_D //alias <alias_name>
{
  use update;
  use delete;

  use association _Travel;
  use association _BookingSupplement { create; }
}

define behavior for ZC_ZBOOKSUPP_MANAGED_D //alias <alias_name>
{
  use update;
  use delete;

  use association _travel;
  use association _booking;
}