managed;
strict ( 2 );
with draft;
define behavior for zi_ztravel_managed_d //alias <alias_name>
implementation in class zbp_i_ztravel_managed_d unique
persistent table /dmo/a_travel_d
lock master
total etag LastChangedAt
draft table zdr_ztravel
//authorization master ( instance )
authorization master ( instance, global )
//etag master <field_name>
{
  create(precheck ) {default function GetDefaultsForCreate; }
  update(precheck);
  delete;
//  field ( readonly, numbering : managed ) TravelUuid ;
  field ( readonly, numbering : managed ) TravelUuid ;
  field( readonly ) TravelId;
  field( readonly ) overallStatus;
  action acceptTravel result[1] $self;
  action rejectTravel result[1] $self;
  action discountadded parameter za_entity_discount_d result[1] $self;

  determination setTravelId on save { create; }
  determination setOverallStatus on save { create; }
  determination calculatePrice on modify { create; field BookingFee, CurrencyCode ; }
  internal action recalculatePrice;
  side effects {
  field BookingFee affects field TotalPrice;
  field CurrencyCode affects field TotalPrice;

}
  association _booking {     create(authorization : update);  with draft; }
  mapping for /dmo/a_travel_d{
  TravelId = Travel_Id;
  TravelUUid = Travel_Uuid;
  BeginDate = Begin_Date;
  BookingFee = Booking_Fee;
  CurrencyCode = Currency_Code;
  CustomerId  = Customer_ID;
  Description = Description;
  EndDate = End_Date;
  LastChangedAt = last_changed_at;
  LocalLastChangedBy = local_last_changed_by;
  TotalPrice = total_price;
  LocalCreatedAt = local_created_at;
  LocalCreatedBy = local_created_by;
  AgencyId = agency_id;
  OverallStatus = overall_status;
  LocalLastChangedAt = local_last_changed_at;
  }

  validation ValidateCustomerId on save { create; field CustomerId; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare{
  validation ValidateCustomerId;
  validation zi_zbooking_managed_d~ValidateCustomerId;
  validation zi_zbooksupp_managed_d~ValidateCustomerId1;
  }

}

define behavior for zi_zbooking_managed_d //alias <alias_name>
implementation in class zbp_i_zbooking_managed_d unique
persistent table /dmo/a_booking_d
draft table zdr_zbooking
lock dependent by _Travel
authorization dependent by _Travel
//etag master <field_name>
{
  update;
  delete;
  field ( readonly, numbering : managed ) BookingUuid;
  field ( readonly  ) TravelUuid;
  field( readonly ) BookingId;
  determination setBookingId on save { create; }
  determination setBookingDate on save { create; }
  determination calculateTotalPrice on modify { create; field FlightPrice, CurrencyCode ; }
  association _Travel { with draft; }
  association _BookingSupplement { create; with draft; }

  mapping for /dmo/a_booking_d {
  TravelUuid = parent_uuid;
  BookingUuid = booking_uuid;
  BookingId = booking_id;
  BookingDate = booking_date;
  BookingStatus = booking_status;
  CurrencyCode = currency_code;
  LocalLastChangedAt = local_last_changed_at;
  CustomerID = customer_id;
  FlightPrice = flight_price;
  ConnectionID = connection_id;
  AirlineID = carrier_id;
  FlightDate = flight_date;
  }

  side effects { field FlightPrice affects field _travel.TotalPrice; }

  validation ValidateCustomerId on save { create; field CustomerId;  }
}

define behavior for zi_zbooksupp_managed_d //alias <alias_name>
implementation in class zbp_i_zbooksupp_managed_d unique
persistent table /dmo/a_bksuppl_d
lock dependent by _travel
draft table zdr_zsupplement
authorization dependent by _travel
//etag master <field_name>
{
  update;
  delete;
  field ( readonly, numbering : managed ) BooksupplUuid;
  field ( readonly ) TravelUuid;
  field ( readonly  ) BookingUuid;
  association _travel{ with draft; }
  association _booking { with draft; }
  mapping for /dmo/a_bksuppl_d{
  TravelUuid = root_uuid;
  BooksupplUuid = booksuppl_uuid;
  BookingUuid = parent_uuid;
  CurrencyCode = Currency_Code;
  LocalLastChangedAt = local_last_changed_at;
  SupplementID = supplement_id;
  BookingSupplementID = booking_supplement_id;
  BookSupplPrice = price;
  }
  validation ValidateCustomerId1 on save { create; field SupplementID; }
}