unmanaged implementation in class zbp_i_ztravel_unmanaged unique;
strict ( 2 );

define behavior for ZI_ZTRAVEL_UNMANAGED alias travel
implementation in class zbp_i_travel_unmanaged unique
late numbering
lock master
authorization master ( instance )

etag master LastChangedAt
{
  create ( authorization : global );

  mapping for /dmo/s_travel_in control /dmo/s_travel_intx
    {
      travelId     = travel_id;
      AgencyId     = agency_id;
      BeginDate    = begin_date;
      EndDate      = end_date;
      BookingFee   = booking_fee;
      CustomerId   = customer_id;
      Description  = description;
      TotalPrice   = total_price;
      CurrencyCode = currency_code;
      overallstatus = status;
    }

  update;
  delete;
  field ( readonly ) TravelId;
  association _Booking { create ( features : instance );  }

}

define behavior for ZI_ZBOOKING_UNMANAGED alias booking
implementation in class zbp_i_booking_unmanaged unique
late numbering
lock dependent by _Travel
authorization dependent by _Travel
etag dependent by _Travel
{

  update;
  delete;
  field ( readonly ) TravelId, BookingId;
  association _Travel;
  mapping for /DMO/S_BOOKING_IN control /dmo/s_booking_intx
    {
      BookingId    = booking_id;
      TravelId     = travel_id;
      CarrierId    = carrier_id;
      ConnectionId = connection_id;
      CurrencyCode = currency_code;
      CustomerId   = customer_id;
      FlightDate   = flight_date;
      FlightPrice  = flight_price;
      BookingDate  = booking_date;
    }
}