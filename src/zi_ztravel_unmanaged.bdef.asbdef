unmanaged implementation in class zbp_i_ztravel_unmanaged unique;
strict ( 2 );

define behavior for ZI_ZTRAVEL_UNMANAGED alias travel
implementation in class zbp_i_travel_unmanaged unique
late numbering
lock master
authorization master ( instance )

etag master LastChangedAt
{
  create ( authorization : global );
   mapping for /dmo/s_travel_in{
   AgencyId = agency_id;
   BeginDate = begin_date;
   EndDate = end_date;
   BookingFee = booking_fee;
   CustomerId = customer_id;
   Description = description;
   TotalPrice = total_price;
   TravelId = travel_id;
   CurrencyCode = currency_code;
}

    mapping for /dmo/s_travel_inx{
    AgencyId = agency_id;
   BeginDate = begin_date;
   EndDate = end_date;
   BookingFee = booking_fee;
   CustomerId = customer_id;
   Description = description;
   TotalPrice = total_price;
   TravelId = travel_id;
   CurrencyCode = currency_code;
    }
  update;
  delete;
  field ( readonly ) TravelId;
  association _Booking { create; }

}

define behavior for ZI_ZBOOKING_UNMANAGED alias booking
implementation in class zbp_i_booking_unmanaged unique
late numbering
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
{
  update;
  delete;
  field ( readonly ) TravelId, BookingId;
  association _Travel;
}